map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Main multiplayer game
server {
    listen ${SSL_PORT} ssl default_server;
    server_name _;

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};

    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

	# API
    location /api/ {
        proxy_pass http://backend:3000;
    }

	# Socket.IO
    location /socket.io/ {
        proxy_pass http://backend:3000;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 3600s;
    }

	# Backend HTML pages
    location = /setup-2fa {
        proxy_pass http://backend:3000;
    }

    location = /verify-2fa {
        proxy_pass http://backend:3000;
    }

    location = /verify-email {
        proxy_pass http://backend:3000;
    }

	# Frontend
    location = /privacy {
        alias /var/www/pages/privacy.html;
        default_type text/html;
    }

    location = /terms {
        alias /var/www/pages/terms.html;
        default_type text/html;
    }

    location = /legal.css {
        alias /var/www/pages/legal.css;
        default_type text/css;
    }

    location / {
        root /var/www/frontend;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}

# Internal NGINX metrics
server {
    listen 3001;
    server_name _;

    location = /stub_status {
        stub_status;
        access_log off;
    }

    location / {
        return 404;
    }
}

# Grafana monitoring
server {
    listen ${SSL_PORT} ssl;
    server_name monitoring.localhost;

    ssl_certificate ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};

    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://grafana:3000;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}